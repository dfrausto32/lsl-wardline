[Unit]
Description=Wardline server (accepts your devices)
After=network-online.target
Wants=network-online.target

[Service]
User=wardline
Group=wardline
EnvironmentFile=/etc/wardline/gateway.env
Environment=WARDLINE_STATE_DIR=/var/lib/wardline-gateway
ExecStart=/usr/local/bin/wardline gateway
Restart=on-failure
RestartSec=3

# Needs to create a network interface, nothing else.
# CAP_DAC_OVERRIDE lets the server write the one kernel switch that decides whether devices can reach each other.
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
StateDirectory=wardline-gateway
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
